      "title_zh": "冠词 a 和 an",
      "title_en": "Articles: a / an",
      "rule_zh": "元音字母 a、e、i、o、u 开头的发音前用 an，其余用 a。",
      "intro_zh": "奥利想拿一个苹果和一本书，可是什么时候说 a，什么时候说 an 呢？",
      "examples": [
        {
          "en": "apple",
          "phrase": "an apple",
          "zh": "一个苹果",
          "asset": "fruits/apple.png"
        },
        {
          "en": "book",
          "phrase": "a book",
          "zh": "一本书",
          "asset": "curriculum/book.png"
        },
        {
          "en": "egg",
          "phrase": "an egg",
          "zh": "一个鸡蛋",
          "asset": "curriculum/egg.png"
        }
      ],
      "quiz": [
        {
          "prompt_en": "___ cat",
          "prompt_zh": "一只小猫，选 a 还是 an？",
          "answer": "a cat",
          "en": "cat",
          "asset": "animals/cat.png"
        },
        {
          "prompt_en": "___ elephant",
          "prompt_zh": "一头大象，选 a 还是 an？",
          "answer": "an elephant",
          "en": "elephant",
          "asset": "curriculum/elephant.png"
        }
      ]
    },
