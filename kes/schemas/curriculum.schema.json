{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kes/curriculum.json",
  "title": "KES Curriculum",
  "type": "object",
  "required": ["schema_version", "level", "age_group", "total_units", "units"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "level": {"type": "string", "pattern": "^level[0-9]+$"},
    "age_group": {"type": "string"},
    "total_units": {"type": "integer", "minimum": 1},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "title_zh", "title_en", "episodes"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^U[0-9]+$"},
          "title_zh": {"type": "string"},
          "title_en": {"type": "string"},
          "episodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["episode_index", "words", "sentence"],
              "properties": {
                "episode_index": {"type": "integer", "minimum": 1, "maximum": 4},
                "words": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "string"}
                },
                "sentence": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
